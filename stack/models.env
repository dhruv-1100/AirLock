# stack/models.env — the pre-staged weights on this box, mapped onto Airlock's roles.
#
#   source it, do not run it:   set -a; source stack/models.env; set +a
#
# Written by B after `gb10/` landed on the box. It sets only environment variables that
# A's launch scripts and A's tier modules already read — no launch flag, no tier logic
# and no GPU process is touched from here (NFR-S1).
#
# ---------------------------------------------------------------------------------
# What is actually on disk, and what each thing is
# ---------------------------------------------------------------------------------
#
#   gb10/models/lightning  21 G   NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4
#                                 NemotronHForCausalLM, MoE, NVFP4. Text generation.
#                                 -> airlock-text :8000   (was Qwen3.6-35B-A3B-NVFP4)
#
#   gb10/models/omni       21 G   Nemotron-3-Nano-Omni-30B-A3B-Reasoning, BF16
#                                 multimodal any-to-any, 30B A3B.
#                                 -> airlock-vision :8001 (was Holo1.5-7B)
#
#   gb10/models/embed     997 M   Nemotron-3-Embed-1B, NVFP4, 2048-d
#                                 NOT WIRED IN. See the warning at the bottom.
#
#   gb10/models/parakeet  2.4 G   ParakeetForTDT — speech-to-text.
#                                 No role in Airlock: nothing in the SRS ingests audio.
#                                 Leave it on disk; do not load it, it buys nothing and
#                                 costs pool.
#
# Also pre-staged and worth knowing about:
#   gb10/images/vllm-arm64.tar    vLLM serving image      (docker load)
#   gb10/images/atlas-arm64.tar   mongodb-atlas-local     (docker load)
#   gb10/wheelhouse/              offline pip wheels — install with --no-index
#   gb10/data/cfpb_narratives.csv the CFPB source build_benign.py recorded as
#                                 "unavailable"; see NOTE-CFPB below.

# ---------------------------------------------------------------------------------
# LAUNCH SHELL — export these in the terminal that runs stack/launch_*.sh
# ---------------------------------------------------------------------------------
# The launch scripts bind-mount $AIRLOCK_MODELS_DIR at /models read-only, so every
# path below is the in-container path.
export AIRLOCK_MODELS_DIR="${AIRLOCK_MODELS_DIR:-$PWD/gb10/models}"

export AIRLOCK_TEXT_MODEL_PATH="/models/lightning"
export AIRLOCK_VLM_MODEL_PATH="/models/omni"

# Committed demo config is TWO servers, not three (SRS §7.3): T2 classification runs on
# the text server with the same guided-JSON schema. Only launch airlock-clf if A's
# measurement shows the 30B missing NFR-L3 p95 <= 600 ms, and then re-cut the budget.
export AIRLOCK_CLF_MODEL_PATH="/models/lightning"

# Serving image. The launch scripts default to vllm/vllm-openai:latest (text) and
# hellohal2064/vllm-dgx-spark-gb10 (vision); NEITHER is on this box, and the pre-staged
# gb10/images/vllm-arm64.tar turns out to be nvcr.io/nvidia/vllm:26.03-py3 — an older
# build of the image already loaded here.
#
# Use NVIDIA's own 26.05.post1, which is loaded and proven on this hardware: the
# af-vllm container ran the multimodal `omni` weights on it for three hours, so SM121
# VLM support (the reason the hellohal image exists) is demonstrated rather than hoped
# for. Pulling an unproven image at bring-up time is the worse risk.
export AIRLOCK_TEXT_IMAGE="${AIRLOCK_TEXT_IMAGE:-nvcr.io/nvidia/vllm:26.05.post1-py3}"
export AIRLOCK_VLM_IMAGE="${AIRLOCK_VLM_IMAGE:-nvcr.io/nvidia/vllm:26.05.post1-py3}"

# nvcr.io/nvidia/vllm execs its Cmd verbatim via nvidia_entrypoint.sh, so the serve
# subcommand has to be part of the command line. With vllm/vllm-openai (ENTRYPOINT
# ["vllm","serve"]) leave both of these unset.
export AIRLOCK_VLLM_ENTRY="${AIRLOCK_VLLM_ENTRY:-vllm serve}"
# The Nemotron weights use custom architectures (NemotronHForCausalLM,
# NemotronH_Nano_Omni_Reasoning_V3) that are not in stock vLLM's registry.
export AIRLOCK_VLLM_EXTRA="${AIRLOCK_VLLM_EXTRA:---trust-remote-code}"

# Leave AIRLOCK_MOE_BACKEND UNSET. See the note in launch_text.sh: the lightning
# checkpoint is MIXED_PRECISION, vLLM selects MARLIN for the NVFP4 MoE layers on its own,
# and forcing it globally kills the engine on the unquantized ones.
# export AIRLOCK_MOE_BACKEND=marlin   # do not enable without re-reading that note

# ---------------------------------------------------------------------------------
# SERVICE SHELL — export these in the terminal that runs services/inspect/app.py
# ---------------------------------------------------------------------------------
# These are REQUEST model names, not paths. The launch scripts pass
# `--served-model-name airlock-text|airlock-vision|airlock-clf`, and vLLM will only
# answer to the name it was served under. Verified against the live :8000 on this box:
#
#   {"model":"/models/lightning"} -> 404 {"message":"The model `/models/lightning`
#                                          does not exist.","type":"NotFoundError"}
#
# So a weights path here breaks /v1/answer and T2/T3 with a 404 that reads like the
# server being down. See INTEGRATION-B.md — A reuses one variable for both jobs.
export AIRLOCK_TEXT_MODEL="airlock-text"
export AIRLOCK_VLM_MODEL="airlock-vision"

# Two-server config: T2 talks to the text server. Flip both of these together if
# airlock-clf is ever launched.
export AIRLOCK_CLF_MODEL="airlock-text"
export AIRLOCK_CLF_URL="http://127.0.0.1:8000/v1"

export AIRLOCK_TEXT_URL="http://127.0.0.1:8000/v1"
export AIRLOCK_VLM_URL="http://127.0.0.1:8001/v1"

# ---------------------------------------------------------------------------------
# NOT WIRED IN — gb10/models/embed, and why
# ---------------------------------------------------------------------------------
# Nemotron-3-Embed-1B is a genuinely better retrieval model than bge-small. It is still
# the wrong choice here, for two reasons that are not preferences:
#
#   1. It is 2048-d. `stack/seed.js` declares the vector index at
#      `numDimensions: 384` and `services/inspect/embed.py` hard-codes EMBED_DIM=384.
#      Swapping the embedder means dropping and rebuilding `airlock_vec` and re-embedding
#      every exemplar in policy_corpus — and a `$vectorSearch` against a non-READY index
#      returns EMPTY RESULTS rather than an error, which presents as a dead detector.
#      SRS §4 is explicit that a late index rebuild is not affordable.
#
#   2. It is an NVFP4 GPU model. NFR-S10 prohibits a third GPU process for embeddings:
#      bge-small (67 MB) and bge-reranker-base run on the 20 Arm cores via ONNX Runtime,
#      and the architecture line is "Grace does retrieval, Blackwell does inference".
#      A CUDA context costs ~300-500 MB plus its own compile warm-up before any weights.
#
# Keep bge-small on CPU. If the team decides otherwise it is C's call, it is a seed-time
# change, and it has to happen before policy_corpus is populated — not after.

# ---------------------------------------------------------------------------------
# NOTE-CFPB
# ---------------------------------------------------------------------------------
# data/ATTRIBUTION.md records CFPB as 0 of a requested 120, method "unavailable", which
# is why benign_v1 is five sources rather than six. `gb10/data/cfpb_narratives.csv` is
# on the box. Pointing bench/build_benign.py at it restores the sixth source and the
# intended mix. C's call, C's file.

# Publish the model servers on the docker bridge as well as loopback, so the OpenShell
# gateway (a container) can reach them as host.openshell.internal. Still not on the LAN.
export AIRLOCK_BRIDGE_IP="${AIRLOCK_BRIDGE_IP:-172.17.0.1}"
