# local model weights, corpora dumps and wheels — 70 GB, pre-staged on the box.
# Never committed: they are inputs to the run, not artifacts of it, and a single
# safetensors shard is larger than GitHub's hard file limit.
gb10/

# macOS finder droppings — one got committed in 3aca041
.DS_Store
**/.DS_Store

# secrets — never commit
.airlock_key
.airlock_resume_token

# generated corpora and results (regenerable with one seeded command)
# data/benign_v1.jsonl is NOT ignored: it is the FP-rate denominator and a required
# submission attachment (SRS §14). Reproduce with
#   python bench/build_benign.py --seed 1337 --out data/benign_v1.jsonl
data/sensitive_v1.jsonl
data/dumps/
results/*.png
results/*.log

